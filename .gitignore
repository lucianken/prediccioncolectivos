# Credenciales
.env
*.env

# Datos grabados (muy grandes, solo en NUC)
grabador/data/

# Datos ML grandes (en NUC, no se versionan)
prediccion/data/ml/
prediccion/data/models/
prediccion/data/registry/

# Pero SÍ versionar el archivo de shapes estático
!prediccion/data/line_shapes.json

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/

# Modelos entrenados (binarios grandes) — ignorar globalmente
*.pkl
*.onnx
*.pt
*.pth

# Excepciones: data/ml/models/ sí se versiona (checkpoints y ONNX producción)
!data/ml/models/*.pt
!data/ml/models/*.onnx
!data/ml/models/*.pkl

# Parquet / ML data
*.parquet
*.jsonl

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
*.pyc

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Pipeline v2: datos grandes fuera de git (se versionan solo lines.json y line_metrics.json)
data/ml/v2/*
!data/ml/v2/lines.json
!data/ml/v2/line_metrics.json
data/ml/v2_smoke*/

# Artefactos generados del pipeline / replay (se regeneran; no se versionan)
data/ml/**/daily/
*.carry.json
data/ml/**/*.log
data/ml/**/*.err
data/ml/**/*.out
data/ml/**/*.npy
data/ml/**/*.npz
data/ml/**/*.ndjson
data/ml/**/*.pkl
flota-historial-sim-datos/
analisis_latencia_fuentes/datos/*.ndjson

# Corridas del replay que se regeneran (los informes y tablas de cada estudio sí se versionan)
data/ml/replay/**/run/
data/ml/replay/prior/test1/
# Export intermedio: es el mismo modelo que path_v4_l1_s1_r20261126 (versionado), ver RECORRIDOS_NUEVOS_42.md
data/ml/export/path_v4_l1_s1_shapes20261126/
# Logs de corridas de experimentos
experiments/**/*.out
experiments/**/*.err
